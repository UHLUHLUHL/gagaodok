# Xcode & Swift Package Manager
.build/
.swiftpm/
Packages/
*.xcodeproj
*.xcworkspace
xcuserdata/

# App Bundles
*.app
*.dSYM
AppIcon.iconset/
output/

# OS generated
.DS_Store
.Spotlight-V100
.Trashes

# Distribution artifacts (빌드된 배포용 파일은 GitHub Release로 올립니다)
dist/

# 아이콘 대조 도구가 만드는 것들 (reference/는 원본 캡처라 남깁니다)
tools/iconcheck/out_*.png
tools/iconcheck/iconshot
tools/iconcheck/KakaoIcons.swift

# 안드로이드
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml

# 아직 정리 전인 옛 저장소 사본. 병합이 끝나면 폴더째 지웁니다.
/KakaoSapiens/

# 자기 GitHub 저장소를 따로 갖고 있는 참고 자료 클론들
/reference/

# Claude Code 로컬 전용 설정
.claude/settings.local.json

# 정체를 확인 못한 생성물 (세션 중 어디선가 떨어진 것으로 보임)
*.webp

# Node.js (cloudflare/sync-worker 등 모든 하위 프로젝트 공통)
node_modules/

# Cloudflare 합성 시험 환경의 작업용 설정과 secret.
# 커밋되는 것은 wrangler.synthetic.template.jsonc 하나뿐이다.
cloudflare/sync-worker/wrangler.synthetic.jsonc
cloudflare/sync-worker/.dev.vars
cloudflare/sync-worker/.dev.vars.*
cloudflare/sync-worker/.wrangler/
